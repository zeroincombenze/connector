<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_synchro_backend_tree" model="ir.ui.view">
        <field name="name">view.synchro.backend.tree</field>
        <field name="model">synchro.channel</field>
        <field name="arch" type="xml">
            <tree string="Synchonization Backend">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="hostname"/>
                <field name="database"/>
                <field name="identity"/>
                <field name="odoo_version"/>
                <field name="method"/>
                <field name="prefix"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_synchro_backend_form" model="ir.ui.view">
        <field name="name">view.synchro.backend.form</field>
        <field name="model">synchro.channel</field>
        <field name="arch" type="xml">
            <form string="Synchonization Backend">
                <header>
                    <button name="button_check_connection" type="object" class="oe_highlight" string="Check Connection" attrs="{'invisible':['|',('state','!=','draft'),('active','=',False)]}"/>
                    <button name="button_reset_to_draft" type="object" string="Reset to draft Connection" attrs="{'invisible':['|',('state','=','draft'),('active','=',False)]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive" attrs="{'invisible':[('state','!=','draft')]}">
                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;active&quot;}"/>
                        </button>
                        <button name="button_build_model_map" type="object" class="oe_stat_button" icon="fa-briefcase" string="Build Models" attrs="{'invisible':['|',('state','in',['draft','failed']),('active','=',False)]}"/>
                        <button name="%(action_wizard_pull_records)d" type="action" class="oe_stat_button" icon="fa-download" string="Pull Records" attrs="{'invisible':['|',('state','=','draft'),('active','=',False)]}"/>
                    </div>
                    <label for="name"/>
                    <h1>
                        <field name="name" class="oe_inline"/>
                    </h1>
                    <group>
                        <group>
                            <field name="method"/>
                            <field name="hostname"/>
                            <field name="port"/>
                            <field name="database"/>
                            <field name="login"/>
                            <field name="password" password="True"/>
                            <field name="client_key" password="True"/>
                            <field name="load_mode"/>
                            <field name="auto_reconnect"/>
                            <field name="pypi_sign" force_save="1"/>
                        </group>
                        <group>
                            <field name="identity"/>
                            <field name="odoo_version"/>
                            <field name="prefix"/>
                            <field name="lgi_path"/>
                            <field name="exchange_path"/>
                            <field name="default_lang_id"/>
                            <field name="deferred_payload"/>
                            <field name="tracelevel"/>
                            <field name="company_id"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group>
                        <field name="counterpart_url"/>
                        <field name="counterpart_data_url"/>
                    </group>
                    <notebook colspan="4">
                        <page name="models" string="Models">
                            <field name="model_ids">
                                <tree string="Model mapping" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="model_spec"/>
                                    <field name="counterpart_name"/>
                                    <field name="use_remote_xref"/>
                                    <field name="auth_action"/>
                                    <field name="field_uname"/>
                                    <field name="parent_name"/>
                                    <field name="childs_name"/>
                                </tree>
                            </field>
                        </page>
                        <page name="logs" string="Logs">
                            <field name="log_ids">
                                <tree string="Event Logs">
                                    <field name="timestamp"/>
                                    <field name="loglevel"/>
                                    <field name="res_model"/>
                                    <field name="res_id"/>
                                    <field name="errcode"/>
                                    <field name="errmsg"/>
                                </tree>
                            </field>
                        </page>
                        <page name="que_jobs" string="Queue Jobs">
                            <field name="queue_jobs"/>
                        </page>
                        <page name="workflow" string="Workflow">
                            <group>
                                <field name="import_workflow"/>
                                <field name="rec_counter"/>
                                <field name="workflow_model"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_synchro_backend" model="ir.actions.act_window">
        <field name="name">Synchonization Backend</field>
        <field name="res_model">synchro.channel</field>
        <field name="view_id" ref="view_synchro_backend_tree"/>
    </record>

    <menuitem id="menu_universal_connector" name="Universal connector" parent="base.next_id_9" groups="base.group_no_one"/>

</odoo>
