<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_synchro_log_form" model="ir.ui.view">
        <field name="name">view.synchro.log.form</field>
        <field name="model">synchro.log</field>
        <field name="arch" type="xml">
            <form string="Synchonization Log">
                <sheet>
                    <group>
                        <field name="timestamp"/>
                        <field name="loglevel"/>
                        <field name="backend_id"/>
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="reference" widget="reference" string="Record" attrs="{'invisible': [('res_model', '=', 'synchro.backend')]}"/>
                        <field name="errcode"/>
                        <field name="errmsg"/>
                        <field name="values"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_synchro_log_tree" model="ir.ui.view">
        <field name="name">view.synchro.log.tree</field>
        <field name="model">synchro.log</field>
        <field name="arch" type="xml">
            <tree string="Synchonization Log">
                <field name="timestamp"/>
                <field name="loglevel"/>
                <field name="backend_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="errcode"/>
                <field name="errmsg"/>
            </tree>
        </field>
    </record>

    <record id="action_synchro_log" model="ir.actions.act_window">
        <field name="name">Synchronization log</field>
        <field name="res_model">synchro.log</field>
        <field name="view_id" ref="view_synchro_log_tree"/>
    </record>

    <menuitem id="menu_synchro_log" name="Synchonization Log" action="action_synchro_log" parent="menu_universal_connector" groups="base.group_no_one" sequence="56"/>

</odoo>
