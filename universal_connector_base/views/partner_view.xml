<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_synchro_form" model="ir.ui.view">
        <field name="name">res.partner.synchro.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page name="synchro" string="Synchronization">
                    <button name="pull_record" string="Synchronize" type="object"/>
                    <group>
                        <field name="timestamp"/>
                        <field name="oe7_id"/>
                        <field name="oe8_id"/>
                        <field name="odoo10_id"/>
                        <field name="odoo12_id"/>
                        <field name="odoo16_id"/>
                        <field name="errmsg"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_category_form" model="ir.ui.view">
        <field name="name">Contact Tags</field>
        <field name="model">res.partner.category</field>
        <field name="inherit_id" ref="base.view_partner_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="oe7_id"/>
                <field name="oe8_id"/>
                <field name="odoo10_id"/>
                <field name="odoo12_id"/>
                <field name="odoo16_id"/>
            </xpath>
        </field>
    </record>
</odoo>
