<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_user_synchro_form" model="ir.ui.view">
        <field name="name">res.user.synchro.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page name="synchro" string="Synchronization">
                    <button name="pull_record" string="Synchronize" type="object"/>
                    <group>
                        <field name="odoo_id"/>
                        <field name="odoo18_id"/>
                        <field name="odoo16_id"/>
                        <field name="odoo14_id"/>
                        <field name="odoo12_id"/>
                        <field name="odoo10_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_groups_form" model="ir.ui.view">
        <field name="name">res.groups.synchro.form</field>
        <field name="model">res.groups</field>
        <field name="inherit_id" ref="base.view_groups_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page name="synchro" string="Synchronization">
                    <button name="pull_record" string="Synchronize" type="object"/>
                    <group>
                        <field name="odoo_id"/>
                        <field name="odoo18_id"/>
                        <field name="odoo16_id"/>
                        <field name="odoo14_id"/>
                        <field name="odoo12_id"/>
                        <field name="odoo10_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
