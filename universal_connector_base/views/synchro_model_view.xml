<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_synchro_model_tree" model="ir.ui.view">
        <field name="name">view.synchro.model.tree</field>
        <field name="model">synchro.model</field>
        <field name="arch" type="xml">
            <tree string="Synchonization model">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_spec"/>
                <field name="counterpart_name"/>
                <field name="use_remote_xref"/>
                <field name="auth_action"/>
                <field name="field_uname"/>
                <field name="parent_name"/>
                <field name="childs_name"/>
                <field name="backend_id"/>
            </tree>
        </field>
    </record>

    <record id="view_synchro_model_form" model="ir.ui.view">
        <field name="name">view.synchro.model.form</field>
        <field name="model">synchro.model</field>
        <field name="arch" type="xml">
            <form string="Synchonization Model">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="model_spec"/>
                        <field name="counterpart_name"/>
                        <field name="use_remote_xref"/>
                        <field name="auth_action"/>
                        <field name="sequence"/>
                        <field name="backend_id"/>
                        <field name="rec_counter"/>
                    </group>
                    <group>
                        <field name="field_uname"/>
                        <field name="search_keys"/>
                        <field name="search_with_company"/>
                        <field name="parent_name"/>
                        <field name="childs_name"/>
                        <field name="state"/>
                        <field name="disable_psql_inquire"/>
                    </group>
                </group>
                <field name="field_ids">
                    <tree string="Field mapping" editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                        <field name="spec"/>
                        <field name="counterpart_name"/>
                        <field name="apply4"/>
                        <field name="default"/>
                        <field name="ttype"/>
                        <field name="protect_update"/>
                        <field name="required"/>
                        <field name="search_role"/>
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <record id="action_synchro_model" model="ir.actions.act_window">
        <field name="name">Synchonization Model</field>
        <field name="res_model">synchro.model</field>
        <field name="view_id" ref="view_synchro_model_tree"/>
    </record>

    <record id="view_synchro_field_tree" model="ir.ui.view">
        <field name="name">view.synchro.mapper.tree</field>
        <field name="model">synchro.mapper</field>
        <field name="arch" type="xml">
            <tree string="Synchonization Field">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="spec"/>
                <field name="counterpart_name"/>
                <field name="apply4"/>
                <field name="default"/>
                <field name="ttype"/>
                <field name="protect_update"/>
                <field name="required"/>
                <field name="model_id"/>
                <field name="model_counterpart_name"/>
                <field name="backend_id"/>
            </tree>
        </field>
    </record>

    <record id="view_synchro_field_form" model="ir.ui.view">
        <field name="name">view.synchro.mapper.form</field>
        <field name="model">synchro.mapper</field>
        <field name="arch" type="xml">
            <form string="Synchonization Field">
                <group>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="spec"/>
                    <field name="counterpart_name"/>
                    <field name="apply4"/>
                    <field name="default"/>
                    <field name="ttype"/>
                    <field name="protect_update"/>
                    <field name="required"/>
                    <field name="search_role"/>
                    <field name="model_id"/>
                    <field name="model_counterpart_name"/>
                    <field name="backend_id"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_synchro_field" model="ir.actions.act_window">
        <field name="name">Synchonization Field</field>
        <field name="res_model">synchro.mapper</field>
        <field name="view_id" ref="view_synchro_field_tree"/>
    </record>

    <record id="view_synchro_tnl_tree" model="ir.ui.view">
        <field name="name">view.synchro.tnl.tree</field>
        <field name="model">synchro.alias</field>
        <field name="arch" type="xml">
            <tree string="Synchonization Alias">
                <field name="model"/>
                <field name="key"/>
                <field name="odoo_value"/>
                <field name="ext_value"/>
            </tree>
        </field>
    </record>

    <record id="view_synchro_tnl_form" model="ir.ui.view">
        <field name="name">view.synchro.tnl.form</field>
        <field name="model">synchro.alias</field>
        <field name="arch" type="xml">
            <form string="Synchonization Alias">
                <group>
                    <field name="model"/>
                    <field name="key"/>
                    <field name="odoo_value"/>
                    <field name="ext_value"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_synchro_model_search" model="ir.ui.view">
        <field name="name">synchro.model.search</field>
        <field name="model">synchro.model</field>
        <field name="arch" type="xml">
            <search string="Model search">
                <field name="name"/>
                <field name="counterpart_name"/>
                <field name="backend_id"/>
                <group expand="0" string="Group By...">
                    <filter name="backend" string="Backend" domain="[]" context="{'group_by' : 'backend_id'}"/>
                    <filter name="model" string="Model" domain="[]" context="{'group_by' : 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_synchro_field_search" model="ir.ui.view">
        <field name="name">synchro.field.search</field>
        <field name="model">synchro.mapper</field>
        <field name="arch" type="xml">
            <search string="Search search">
                <field name="name"/>
                <field name="counterpart_name"/>
                <field name="model_id"/>
                <field name="backend_id"/>
                <group expand="0" string="Group By...">
                    <filter name="model" string="Model" domain="[]" context="{'group_by' : 'model_id'}"/>
                    <filter name="counterpart" string="Counterpart Model" domain="[]" context="{'group_by' : 'model_counterpart_name'}"/>
                    <filter name="name" string="Name" domain="[]" context="{'group_by' : 'name'}"/>
                    <filter name="counterpart_name" string="Counterpart Name" domain="[]" context="{'group_by' : 'counterpart_name'}"/>
                    <filter name="backend" string="Backend" domain="[]" context="{'group_by' : 'backend_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_synchro_tnl" model="ir.actions.act_window">
        <field name="name">Field Value Alias</field>
        <field name="res_model">synchro.alias</field>
        <field name="view_id" ref="view_synchro_tnl_tree"/>
    </record>

    <menuitem id="menu_synchro_backend" name="Synchonization Backend" action="action_synchro_backend" parent="menu_universal_connector" groups="base.group_no_one" sequence="16"/>

    <menuitem id="menu_synchro_model" name="Synchonization Model" action="action_synchro_model" parent="menu_universal_connector" groups="base.group_no_one" sequence="24"/>

    <menuitem id="menu_synchro_field" name="Synchonization Field" action="action_synchro_field" parent="menu_universal_connector" groups="base.group_no_one" sequence="32"/>

    <menuitem id="menu_synchro_translation" name="Translation Alias" action="action_synchro_tnl" parent="menu_universal_connector" groups="base.group_no_one" sequence="64"/>

</odoo>
