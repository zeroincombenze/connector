<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_synchro_identity_form" model="ir.ui.view">
        <field name="name">view.synchro.identity.form</field>
        <field name="model">synchro.identity</field>
        <field name="arch" type="xml">
            <form string="Counterpart Identity">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;active&quot;}"/>
                        </button>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="default_protocol_id"/>
                        <field name="default_login"/>
                        <field name="default_password"/>
                        <field name="default_port"/>
                        <field name="default_lgi_path"/>
                        <field name="default_exchange_path"/>
                        <field name="remote_sw_version"/>
                        <field name="default_prefix"/>
                        <field name="sequence"/>
                        <field name="enabled_protocols"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_synchro_identity_tree" model="ir.ui.view">
        <field name="name">view.synchro.identity.tree</field>
        <field name="model">synchro.identity</field>
        <field name="arch" type="xml">
            <tree string="Counterpart Identity">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="default_protocol_id"/>
                <field name="default_login"/>
                <field name="default_port"/>
                <field name="remote_sw_version"/>
                <field name="default_prefix"/>
            </tree>
        </field>
    </record>

    <record id="action_synchro_identity" model="ir.actions.act_window">
        <field name="name">Counterpart Identity</field>
        <field name="res_model">synchro.identity</field>
        <field name="view_id" ref="view_synchro_identity_tree"/>
    </record>

    <menuitem id="menu_synchro_identity" name="Counterpart Identity" action="action_synchro_identity" parent="menu_universal_connector" groups="base.group_no_one" sequence="52"/>

</odoo>
