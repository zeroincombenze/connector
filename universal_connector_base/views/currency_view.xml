<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_currency_synchro_form" model="ir.ui.view">
        <field name="name">view.currency.synchro.form</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[last()]" position="after">
                <group string="Synchronization">
                    <field name="odoo_id"/>
                    <field name="odoo16_id"/>
                    <field name="odoo14_id"/>
                    <field name="odoo12_id"/>
                    <field name="odoo10_id"/>
                </group>
            </xpath>
        </field>
    </record>

