<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="protocol_xmlrpc_https" model="synchro.protocol">
        <field name="code">xmlrpc/https</field>
        <field name="name">xmlrpc over https</field>
        <field name="http_protocol" eval="True"/>
        <field name="secure_protocol" eval="True"/>
        <field name="pylib">xmlrpc</field>
    </record>

    <record id="protocol_xmlrpc_http" model="synchro.protocol">
        <field name="code">xmlrpc/http</field>
        <field name="name">xmlrpc over http</field>
        <field name="http_protocol" eval="True"/>
        <field name="secure_protocol" eval="False"/>
        <field name="pylib">xmlrpc</field>
    </record>

</odoo>
