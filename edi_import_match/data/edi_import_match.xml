<?xml version="1.0" encoding="utf-8"?>

<odoo noupdate="1">
    <!-- Match partners by name, VAT when is_company is True and no parent -->
    <record model="edi.import.match" id="res_partner_namevat">
        <field name="model_id" eval="ref('base.model_res_partner')"/>
        <field name="sequence" type="int">10</field>
    </record>
    <record model="edi.import.match.field" id="res_partner_namevat_name">
