<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="view_odoo_partner_bind_ids" model="ir.ui.view">
            <field name="name">odoo.res.partner.bind</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="//page[last()]" position="after">
                    <page name="synchro" string="External Objects">
                        <group>
                            <field name="bind_ids" />
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_odoo_partner_tree" model="ir.ui.view">
            <field name="name">odoo.res.partner.tree</field>
            <field name="model">odoo.res.partner</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="backend_id" />
                    <field name="odoo_id" />
                    <field name="external_id" />
                </tree>
            </field>
        </record>

        <record id="view_odoo_partner_form" model="ir.ui.view">
            <field name="name">odoo.res.partner.form</field>
            <field name="model">odoo.res.partner</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name" readonly="1" />
                            </h1>
                        </div>
                        <group>
                            <field name="backend_id" />
                            <field name="odoo_id" />
                            <field name="external_id" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
