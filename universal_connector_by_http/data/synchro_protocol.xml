<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="protocol_https" model="synchro.protocol">
        <field name="code">https</field>
        <field name="name">xmlrpc over https</field>
        <field name="http_protocol" eval="True"/>
        <field name="secure_protocol" eval="True"/>
        <field name="pylib">requests</field>
    </record>

    <record id="protocol_http" model="synchro.protocol">
        <field name="code">http</field>
        <field name="name">xmlrpc over http</field>
        <field name="http_protocol" eval="True"/>
        <field name="secure_protocol" eval="False"/>
        <field name="pylib">requests</field>
    </record>

</odoo>
