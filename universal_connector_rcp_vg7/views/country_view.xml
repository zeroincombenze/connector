<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_country_synchro_form" model="ir.ui.view">
        <field name="name">res.country.synchro.form</field>
        <field name="model">res.country</field>
        <field name="inherit_id" ref="universal_connector_base.view_country_synchro_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='oe16_id']" position="after">
                <field name="vg7_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_country_state_synchro_form" model="ir.ui.view">
        <field name="name">res.country.state.synchro.form</field>
        <field name="model">res.country.state</field>
        <field name="inherit_id" ref="universal_connector_base.view_country_state_synchro_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='oe16_id']" position="after">
                <field name="vg7_id"/>
            </xpath>
        </field>
    </record>

</odoo>
