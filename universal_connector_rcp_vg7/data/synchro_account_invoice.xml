<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <record forcecreate="1" id="account_invoice" model="synchro.model">
        <field name="name">account.invoice</field>
        <field name="field_uname">number</field>
        <field name="backend_id" ref="backend_vg7"/>
    </record>

    <record forcecreate="1" id="account_invoice_line" model="synchro.model">
        <field name="name">account.invoice.line</field>
        <field name="field_uname">name</field>
        <field name="search_keys">(['invoice_id', 'sequence'], ['invoice_id', 'name'])</field>
        <field name="sequence">18</field>
        <field name="backend_id" ref="backend_vg7"/>
    </record>


    <record forcecreate="1" id="account_invoice_carriage_condition_id" model="synchro.mapper">
        <field name="name">carriage_condition_id</field>
        <field name="model_id" ref="account_invoice"/>
    </record>

    <record forcecreate="1" id="account_invoice_carrier_id" model="synchro.mapper">
