        <field name="model_id" ref="account_invoice"/>
    </record>

    <record forcecreate="1" id="account_invoice_company_id" model="synchro.mapper">
        <field name="name">company_id</field>
        <field name="apply4">get_global()</field>
        <field name="model_id" ref="account_invoice"/>
    </record>

    <record forcecreate="1" id="account_invoice_date" model="synchro.mapper">
