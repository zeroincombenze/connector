<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <!-- pylint:disable=redefined-builtin -->

    <record forcecreate="1" id="purchase_order" model="synchro.model">
        <field name="name">purchase.order</field>
        <field name="field_uname">name</field>
        <field name="counterpart_name">purchase_orders</field>
        <field name="backend_id" ref="backend_vg7"/>
    </record>

    <record forcecreate="1" id="purchase_order_line" model="synchro.model">
        <field name="name">purchase.order.line</field>
        <field name="field_uname">name</field>
        <field name="search_keys">(['order_id', 'sequence'], ['order_id', 'name'])</field>
        <field name="sequence">18</field>
        <field name="backend_id" ref="backend_vg7"/>
    </record>


    <record forcecreate="1" id="purchase_order_order_line" model="synchro.mapper">
        <field name="name">order_line</field>
        <field name="counterpart_name">order_rows</field>
        <field name="model_id" ref="purchase_order"/>
    </record>

    <!--
    <record forcecreate="1" id="purchase_order_state" model="synchro.mapper">
        <field name="name">state</field>
        <field name="counterpart_name">order_state_id</field>
        <field name="apply4">set_order_state()</field>
        <field name="model_id" ref="purchase_order"/>
    </record>
    -->

    <record forcecreate="1" id="purchase_order_date_order" model="synchro.mapper">
        <field name="name">date_order</field>
        <field name="counterpart_name">date</field>
        <field name="model_id" ref="purchase_order"/>
    </record>

    <record forcecreate="1" id="purchase_order_date_planned" model="synchro.mapper">
        <field name="name">date_planned</field>
        <field name="apply4">next_week_day()</field>
        <field name="model_id" ref="purchase_order"/>
    </record>

    <record forcecreate="1" id="purchase_order_name" model="synchro.mapper">
        <field name="name">name</field>
        <field name="counterpart_name">order_id</field>
        <field name="apply4">str()</field>
        <field name="model_id" ref="purchase_order"/>
    </record>

    <record forcecreate="1" id="purchase_order_partner_ref" model="synchro.mapper">
        <field name="name">partner_ref</field>
        <field name="counterpart_name">order_number</field>
        <field name="model_id" ref="purchase_order"/>
    </record>

    <record forcecreate="1" id="purchase_order_company_id" model="synchro.mapper">
        <field name="name">company_id</field>
        <field name="apply4">get_global()</field>
        <field name="model_id" ref="purchase_order"/>
    </record>

    <record forcecreate="1" id="purchase_order_partner_id" model="synchro.mapper">
        <field name="name">partner_id</field>
        <field name="counterpart_name">supplier_id</field>
        <field name="model_id" ref="purchase_order"/>
    </record>

    <record forcecreate="1" id="purchase_order_fiscal_position_id" model="synchro.mapper">
        <field name="name">fiscal_position_id</field>
        <field name="apply4">partner_info()</field>
        <field name="required" eval="True"/>
        <field name="model_id" ref="purchase_order"/>
    </record>


    <record forcecreate="1" id="purchase_order_line_name" model="synchro.mapper">
        <field name="name">name</field>
        <field name="counterpart_name">descrizione</field>
        <field name="model_id" ref="purchase_order_line"/>
    </record>

    <record forcecreate="1" id="purchase_order_line_date_planned" model="synchro.mapper">
        <field name="name">date_planned</field>
        <field name="apply4">next_week_day()</field>
        <field name="model_id" ref="purchase_order_line"/>
    </record>

    <record forcecreate="1" id="purchase_order_line_price_unit" model="synchro.mapper">
        <field name="name">price_unit</field>
        <field name="counterpart_name">prezzo_unitario</field>
        <field name="model_id" ref="purchase_order_line"/>
    </record>

    <record forcecreate="1" id="purchase_order_line_product_id" model="synchro.mapper">
        <field name="name">product_id</field>
        <field name="counterpart_name">prodotto</field>
        <field name="apply4">prod_by_name(),line_vals_from_prod()</field>
        <field name="model_id" ref="purchase_order_line"/>
    </record>

    <record forcecreate="1" id="purchase_order_line_product_uom" model="synchro.mapper">
        <field name="name">product_uom</field>
        <field name="counterpart_name">um_id</field>
        <field name="apply4">uom()</field>
        <field name="model_id" ref="purchase_order_line"/>
    </record>

    <record forcecreate="1" id="purchase_order_line_product_uom_qty" model="synchro.mapper">
        <field name="name">product_qty</field>
        <field name="counterpart_name">quantita</field>
        <field name="model_id" ref="purchase_order_line"/>
    </record>

    <record forcecreate="1" id="purchase_order_line_tax_id" model="synchro.mapper">
        <field name="name">taxes_id</field>
        <field name="counterpart_name">tax_code_id</field>
        <field name="apply4">tax()</field>
        <field name="model_id" ref="purchase_order_line"/>
    </record>

    <record forcecreate="1" id="purchase_order_line_to_delete" model="synchro.mapper">
        <field name="name">to_delete</field>
        <field name="default" eval="False"/>
        <field name="model_id" ref="purchase_order_line"/>
    </record>

</odoo>
