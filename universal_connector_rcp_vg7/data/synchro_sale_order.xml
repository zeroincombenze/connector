<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <record forcecreate="1" id="sale_order" model="synchro.model">
        <field name="name">sale.order</field>
        <field name="field_uname">name</field>
        <field name="counterpart_name">orders</field>
        <field name="backend_id" ref="backend_vg7"/>
    </record>

    <record forcecreate="1" id="sale_order_line" model="synchro.model">
        <field name="name">sale.order.line</field>
        <field name="field_uname">name</field>
        <field name="search_keys">(['order_id', 'sequence'], ['order_id', 'name'])</field>
        <field name="sequence">18</field>
        <field name="backend_id" ref="backend_vg7"/>
    </record>


    <record forcecreate="1" id="sale_order_order_line" model="synchro.mapper">
        <field name="name">order_line</field>
        <field name="counterpart_name">order_rows</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_state" model="synchro.mapper">
        <field name="name">state</field>
        <field name="counterpart_name">order_state</field>
        <field name="apply4">set_order_state()</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_id" model="synchro.mapper">
        <field name="name">id</field>
        <field name="counterpart_name">order_id</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_company_id" model="synchro.mapper">
        <field name="name">company_id</field>
        <field name="apply4">get_global()</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_carriage_condition_id" model="synchro.mapper">
        <field name="name">carriage_condition_id</field>
        <field name="apply4">partner_info()</field>
        <field name="required" eval="True"/>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_carrier_id" model="synchro.mapper">
        <field name="name">carrier_id</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_client_order_ref" model="synchro.mapper">
        <field name="name">client_order_ref</field>
        <field name="counterpart_name">name</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_date_order" model="synchro.mapper">
        <field name="name">date_order</field>
        <field name="counterpart_name">date</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_goods_description_id" model="synchro.mapper">
        <field name="name">goods_description_id</field>
        <field name="apply4">partner_info()</field>
        <field name="required" eval="True"/>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_gross_weight" model="synchro.mapper">
        <field name="name">gross_weight</field>
        <field name="apply4">partner_info()</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_incoterm" model="synchro.mapper">
        <field name="name">incoterm</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_name" model="synchro.mapper">
        <field name="name">name</field>
        <field name="counterpart_name">order_number</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_note" model="synchro.mapper">
        <field name="name">note</field>
        <field name="apply4">company_info()</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_parcels" model="synchro.mapper">
        <field name="name">parcels</field>
        <field name="apply4">partner_info()</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_partner_id" model="synchro.mapper">
        <field name="name">partner_id</field>
        <field name="counterpart_name">customer_id</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_partner_shipping_id" model="synchro.mapper">
        <field name="name">partner_shipping_id</field>
        <field name="counterpart_name">customer_shipping_id</field>
        <field name="apply4">partner_address()</field>
        <field name="spec">delivery</field>
        <field name="required" eval="True"/>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_payment_term_id" model="synchro.mapper">
        <field name="name">payment_term_id</field>
        <field name="counterpart_name">payment_id</field>
        <field name="apply4">partner_info()</field>
        <field name="required" eval="True"/>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_pricelist_id" model="synchro.mapper">
        <field name="name">pricelist_id</field>
        <field name="apply4">partner_info()</field>
        <field name="required" eval="True"/>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_fiscal_position_id" model="synchro.mapper">
        <field name="name">fiscal_position_id</field>
        <field name="apply4">partner_info()</field>
        <field name="required" eval="True"/>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_transportation_reason_id" model="synchro.mapper">
        <field name="name">transportation_reason_id</field>
        <field name="apply4">partner_info()</field>
        <field name="required" eval="True"/>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_transportation_method_id" model="synchro.mapper">
        <field name="name">transportation_method_id</field>
        <field name="apply4">partner_info()</field>
        <field name="required" eval="True"/>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_volume" model="synchro.mapper">
        <field name="name">volume</field>
        <field name="apply4">partner_info()</field>
        <field name="model_id" ref="sale_order"/>
    </record>

    <record forcecreate="1" id="sale_order_weight" model="synchro.mapper">
        <field name="name">weight</field>
        <field name="apply4">partner_info()</field>
        <field name="model_id" ref="sale_order"/>
    </record>


    <record forcecreate="1" id="sale_order_line_agents" model="synchro.mapper">
        <field name="name">agents</field>
        <field name="apply4">agents()</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_discount" model="synchro.mapper">
        <field name="name">discount</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_name" model="synchro.mapper">
        <field name="name">name</field>
        <field name="counterpart_name">job_name</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_order_id" model="synchro.mapper">
        <field name="name">order_id</field>
        <field name="counterpart_name">order_id</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_price_unit" model="synchro.mapper">
        <field name="name">price_unit</field>
        <field name="counterpart_name">unitary_price</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_product_id" model="synchro.mapper">
        <field name="name">product_id</field>
        <field name="counterpart_name">product_name</field>
        <field name="apply4">line_vals_from_prod()</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_product_uom" model="synchro.mapper">
        <field name="name">product_uom</field>
        <field name="apply4">uom()</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_product_uom_qty" model="synchro.mapper">
        <field name="name">product_uom_qty</field>
        <field name="counterpart_name">quantity</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_sequence" model="synchro.mapper">
        <field name="name">sequence</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_tax_id" model="synchro.mapper">
        <field name="name">tax_id</field>
        <field name="apply4">tax()</field>
        <field name="model_id" ref="sale_order_line"/>
    </record>

    <record forcecreate="1" id="sale_order_line_to_delete" model="synchro.mapper">
        <field name="name">to_delete</field>
        <field name="default" eval="False"/>
        <field name="model_id" ref="sale_order_line"/>
    </record>

</odoo>
