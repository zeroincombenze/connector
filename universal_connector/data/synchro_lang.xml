<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record forcecreate="1" id="res_lang" model="synchro.channel.model">
        <field name="name">res.lang</field>
        <field name="field_uname">code</field>
        <field name="search_keys">(['code'],['name'])</field>
        <field name="sequence">48</field>
        <field name="synchro_channel_id" ref="channel_vg7"/>
    </record>


    <record forcecreate="1" id="res_lang_code" model="synchro.channel.model.fields">
        <field name="name">code</field>
        <field name="apply">upper()</field>
        <field name="model_id" ref="res_lang"/>
    </record>

    <record forcecreate="1" id="res_lang_name" model="synchro.channel.model.fields">
        <field name="name">name</field>
        <field name="model_id" ref="res_lang"/>
    </record>

</odoo>
