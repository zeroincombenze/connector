<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transportation_reason_form" model="ir.ui.view">
        <field name="name">view.transportation_reason.form</field>
        <field name="model">stock.picking.transportation_reason</field>
        <field name="inherit_id" ref="l10n_it_ddt.view_transportation_reason_form"/>
        <field eval="99" name="priority"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <group>
                    <field name="vg7_id"/>
                    <field name="oe7_id"/>
                    <field name="oe8_id"/>
                    <field name="oe10_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_ddt_synchro_form" model="ir.ui.view">
        <field name="name">res.ddt.synchro.form</field>
        <field name="model">stock.picking.package.preparation</field>
        <field name="inherit_id"
               ref="stock_picking_package_preparation_line.sppp_line_stock_picking_package_preparation_form"/>
        <field eval="99" name="priority"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page name="synchro" string="Synchronization">
                    <button name="pull_record" string="Synchronize" type="object"/>
                    <group>
                        <field name="timestamp"/>
                        <field name="vg7_id"/>
                        <field name="oe7_id"/>
                        <field name="oe8_id"/>
                        <field name="oe10_id"/>
                        <field name="original_state"/>
                        <field name="errmsg"/>
                    </group>
                </page>
            </xpath>

            <xpath expr="//field[@name='line_ids']/form//group[last()]" position="after">
                <group>
                    <field name="vg7_id"/>
                    <field name="oe7_id"/>
                    <field name="oe8_id"/>
                    <field name="oe10_id"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
