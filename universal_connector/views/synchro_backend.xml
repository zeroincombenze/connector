<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_synchro_backend_tree" model="ir.ui.view">
        <field name="name">synchro.backend.tree</field>
        <field name="model">synchro.backend</field>
        <field name="arch" type="xml">
            <tree string="Odoo Backends">
                <field name="sequence" widget="handle"/>
                <field name="display_name"/>
                <field name="identity_id"/>
                <field name="version"/>
                <field name="hostname"/>
                <field name="protocol_id"/>
                <field name="port"/>
                <field name="database"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_synchro_backend_form" model="ir.ui.view">
        <field name="name">synchro.backend.form</field>
        <field name="model">synchro.backend</field>
        <field name="arch" type="xml">
            <form string="Odoo Backend">
                <header>
                    <button name="button_check_connection"
                            type="object"
                            class="oe_highlight"
                            string="Check Connection"
                            attrs="{'invisible':[('state', 'not in', ['draft'])]}"
                    />
                    <button name="button_reset_to_draft"
                            type="object"
                            string="Reset To draft Connection"
                            attrs="{'invisible':[('state', 'in', ['draft'])]}"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" widget="boolean_button"
                               options='{"terminology": "archive"}'
                        />
                        <button name="button_discover_peer_model"
                                type="object"
                                string="Discover models"
                        />
                    </div>
                    <label for="display_name" />
                    <h1>
                        <field name="display_name"
                               class="oe_inline"
                        />
                    </h1>
                    <group>
                        <group>
                            <field name="hostname"/>
                            <field name="identity_id"/>
                            <field name="version"/>
                            <field name="protocol_id"/>
                            <field name="port"/>
                            <field name="create_only"/>
                            <field name="login_endpoint"/>
                        </group>
                        <group>
                            <field name="database"/>
                            <field name="login"/>
                            <field name="password" password="1"/>
                            <field name="default_lang_id"/>
                            <field name="default_user_id"/>
                            <field name="use_queue"/>
                            <field name="data_endpoint"/>
                            <field name="pypi_sign"/>
                        </group>
                    </group>
                    <field name="model_ids">
                        <tree string="Model mapping" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="peer_name"/>
                            <field name="model_id"/>
                            <field name="permission"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_synchro_backend" model="ir.actions.act_window">
        <field name="name">Odoo Backends</field>
        <field name="res_model">synchro.backend</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="menu_odoo_root"
            name="Odoo"
            parent="connector.menu_connector_root"
            sequence="10"
    />
    <!-- TODO: Implement security strategy groups="odoo_base.group_synchro_manager" -->
    <menuitem
            id="menu_synchro_backends"
            name="Backends"
            parent="menu_odoo_root"
            sequence="10"
            action="action_synchro_backend"
    />

</odoo>
